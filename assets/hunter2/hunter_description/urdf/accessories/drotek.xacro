<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Ouster -->
  <link name="drotek_link">
    <visual>
      <geometry>
        <mesh filename="package://hunter_description/meshes/accessories/sensors/drotek.dae" scale="0.1 0.1 0.1" />
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://hunter_description/meshes/accessories/sensors/drotek.dae" scale="0.1 0.1 0.1" />
      </geometry>
    </collision>
  </link>

  <joint name="drotek_joint" type="fixed">
    <parent link="rnd_kit_link" />
    <child link="drotek_link" />
    <origin xyz="-0.55 0 -0.015" rpy="0 0 0" />
  </joint>

</robot>