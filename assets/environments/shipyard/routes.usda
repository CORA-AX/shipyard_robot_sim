#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "RoadNetwork"
    {
        def "Looks"
        {
            def Material "Asphalt"
            {
                token outputs:surface.connect = </World/RoadNetwork/Looks/Asphalt/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.075, 0.09, 0.105)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.82
                    token outputs:surface
                }
            }

            def Material "Concrete"
            {
                token outputs:surface.connect = </World/RoadNetwork/Looks/Concrete/Surface.outputs:surface>

