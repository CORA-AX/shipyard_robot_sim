                }
            }

            def Material "Traction" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.8
                float physics:restitution = 0
                float physics:staticFriction = 0.9
            }

            def "Source"
            {
                def Material "m0_concrete"
                {
                    token outputs:surface.connect = </World/RoadNetwork/Looks/Source/m0_concrete/Surface.outputs:surface>

                    def Shader "Surface"
                    {
                        uniform token info:id = "UsdPreviewSurface"
                        color3f inputs:diffuseColor = (0.71, 0.7, 0.68)
                        color3f inputs:diffuseColor.connect = </World/RoadNetwork/Looks/Source/m0_concrete/Texture.outputs:rgb>
                        float inputs:metallic = 0
                        float inputs:roughness = 1
                        token outputs:surface
                    }

                    def Shader "UV"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname = "st"
                        float2 outputs:result
                    }

                    def Shader "Texture"
                    {
                        uniform token info:id = "UsdUVTexture"
                        asset inputs:file = @./textures/image_0.png@
                        float4 inputs:scale = (0.71, 0.7, 0.68, 1)
                        token inputs:sourceColorSpace = "sRGB"
                        float2 inputs:st.connect = </World/RoadNetwork/Looks/Source/m0_concrete/UV.outputs:result>
                        token inputs:wrapS = "repeat"
                        token inputs:wrapT = "repeat"
                        float3 outputs:rgb
                    }
