Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Splitter Ratio: 0.5
- Class: rviz_common/Tool Properties
  Name: Tool Properties
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
Visualization Manager:
  Class: ''
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 40; 44; 52
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid (0.5 m)
    Enabled: true
    Plane: XY
    Plane Cell Count: 20
    Cell Size: 0.5
    Color: 110; 115; 125
    Alpha: 0.5
  - Class: rviz_default_plugins/TF
    Name: Robot frames
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: false
    Marker Scale: 1.5
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetGoal
    Topic: /waypoint/goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: map
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.2
      Pitch: 0.85
      Yaw: 0.785398
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
  Value: true
Window Geometry:
  Width: 1400
  Height: 840
  X: 10
  Y: 10
  QMainWindow State: 
